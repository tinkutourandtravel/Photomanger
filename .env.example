DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photo_manager?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photo_manager_shadow?schema=public"
JWT_SECRET="replace-with-a-strong-secret"
NEXTAUTH_SECRET="replace-with-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# URLs used by the backend OAuth callbacks and the browser redirect after sign-in.
APP_URL="http://localhost:5173"
OAUTH_REDIRECT_BASE_URL="http://localhost:4000"

# Google OAuth 2.0 web application credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra ID (Azure AD) application credentials
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Sign in with Apple web credentials. APPLE_PRIVATE_KEY may use escaped newlines (\\n).
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
